{
  "name": "reaxuse",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.4",
  "description": "Reactive utilities for React — an experimental 1:1 AI-mapped port of VueUse",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "playgrounds/*"
  ],
  "scripts": {
    "backport": "tsx scripts/backport.ts",
    "build": "npm run update && npm run build:packages",
    "build:packages": "turbo run build",
    "build:redirects": "tsx scripts/redirects.ts",
    "changelog": "tsx scripts/changelog.ts",
    "clean": "tsx scripts/clean.ts",
    "dev": "npm run update && npm run docs",
    "docs": "vitepress dev packages",
    "docs:build": "npm run update && npm run build:packages && vitepress build packages && npm run build:redirects",
    "docs:serve": "vitepress serve packages",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "publish:ci": "tsx scripts/publish.ts",
    "release": "bumpp --execute=\"npm run release:prepare\" --all --pr",
    "release:prepare": "npm run update && npm run build:packages",
    "size": "tsx scripts/export-size.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:exports": "vitest run --project exports",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "up": "taze",
    "update": "tsx scripts/update.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/vitepress": "^1.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "bumpp": "^12.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "^2.0.1",
    "next": "^15.5.25",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "taze": "^21.1.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
