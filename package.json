{
  "name": "reaxuse",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Reactive utilities for React — an experimental 1:1 AI-mapped port of VueUse",
  "license": "MIT",
  "scripts": {
    "backport": "tsx scripts/backport.ts",
    "build": "pnpm run update && pnpm run build:packages",
    "build:packages": "turbo run build",
    "build:redirects": "tsx scripts/redirects.ts",
    "changelog": "tsx scripts/changelog.ts",
    "clean": "tsx scripts/clean.ts",
    "dev": "pnpm run update && pnpm run docs",
    "docs": "vitepress dev packages",
    "docs:build": "pnpm run update && pnpm run build:packages && vitepress build packages && pnpm run build:redirects",
    "docs:serve": "vitepress serve packages",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "publish:ci": "tsx scripts/publish.ts",
    "prepare": "simple-git-hooks",
    "release": "bumpp --execute=\"pnpm run release:prepare\" --all --pr",
    "release:prepare": "pnpm run update && pnpm run build:packages",
    "size": "tsx scripts/export-size.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:exports": "vitest run --project exports",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "up": "taze",
    "update": "tsx scripts/update.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@reaxuse/core": "workspace:*",
    "@reaxuse/integrations": "workspace:*",
    "@reaxuse/math": "workspace:*",
    "@reaxuse/metadata": "workspace:*",
    "@reaxuse/shared": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@types/sortablejs": "^1.15.9",
    "@unocss/postcss": "66.10.1",
    "@vite-pwa/vitepress": "^1.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "async-validator": "^4.2.5",
    "axios": "^1.20.0",
    "bumpp": "^12.3.0",
    "changelogen": "^0.6.2",
    "drauu": "^1.0.0",
    "electron": "^13.6.9",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "^2.0.1",
    "export-size": "^0.8.0",
    "firebase": "^12.18.0",
    "fuse.js": "^7.5.0",
    "idb-keyval": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "lint-staged": "^16.4.0",
    "next": "^15.5.25",
    "nprogress": "^0.2.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^6.6.7",
    "simple-git-hooks": "^2.14.0",
    "sortablejs": "^1.15.7",
    "taze": "^21.1.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.6.3",
    "universal-cookie": "^8.1.2",
    "unocss": "66.10.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json}": [
      "eslint --cache --fix"
    ]
  }
}
