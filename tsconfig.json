{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "meta/**/*.ts",
    "docs/demos/**/*.ts",
    "docs/demos/**/*.tsx",
    "docs/.vitepress/**/*.ts",
    "*.config.ts",
    "*.config.js"
  ]
}
