{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "update": {
      "cache": false
    },
    "//#docs:build:vitepress": {
      "outputs": ["packages/.vitepress/dist/**"]
    }
  }
}
