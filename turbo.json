{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "../../tsdown.config.ts",
        "../../meta/packages.ts",
        "tsdown.config.ts",
        "package.json",
        "index.ts",
        "src/**",
        "*/index.tsx",
        "*/index.ts",
        "!**/index.test.tsx",
        "!**/demo.tsx"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "../../tsconfig.json",
        "tsconfig.json",
        "package.json",
        "index.ts",
        "src/**",
        "*/index.tsx",
        "*/index.ts"
      ]
    },
    "update": {
      "cache": false
    },
    "//#docs:build:vitepress": {
      "outputs": ["packages/.vitepress/dist/**"]
    }
  }
}
